# Install-time hardening is normative (§3.5.2). This file is a gate (6.16).
# Changing it requires a supply-chain ADR amendment.
ignore-scripts=true
save-exact=true
strict-peer-dependencies=true
auto-install-peers=false
verify-store-integrity=true
lockfile-include-tarball-url=false
minimum-release-age=4320
audit-level=high
fund=false
